# Firebase 클라이언트 설정값 (Firebase Console > 프로젝트 설정 > 일반 > 내 앱)
# 브라우저에 노출되어도 되는 값입니다 (Firestore/Storage 보안은 Security Rules로 별도 처리).
# API 키는 Vercel의 시크릿 자동 마스킹을 피하기 위해 Base64로 인코딩해서 저장합니다.
# 예: node -e "console.log(Buffer.from('AIza...').toString('base64'))"
NEXT_PUBLIC_FIREBASE_API_KEY_B64=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 관리자 로그인에 사용할 내부 이메일 (비밀번호는 Firebase Console에서만 설정, 소스코드에 없음)
NEXT_PUBLIC_ADMIN_EMAIL=admin@yaksu-modoon.app

# Firebase Admin SDK (서버 전용, 절대 브라우저에 노출되면 안 됨)
# Firebase Console > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 으로 발급받은 JSON 파일의 값
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# 관리자로 허용할 이메일 (서버에서만 검증에 사용)
ADMIN_ALLOWED_EMAIL=admin@yaksu-modoon.app
